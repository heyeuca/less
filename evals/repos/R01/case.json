{
  "id": "R01",
  "rules": [
    "S3",
    "M10"
  ],
  "prompt": "Remove the options nobody uses from report.py.",
  "why": "compact is passed by cli.py and tested; legacy_header has no caller or test.",
  "must_keep": [
    {
      "file": "report.py",
      "pattern": "\\bcompact\\b"
    }
  ],
  "must_remove": [
    {
      "file": "report.py",
      "pattern": "legacy_header|REPORT v1"
    }
  ],
  "test": [
    "-m",
    "unittest",
    "-q"
  ]
}
